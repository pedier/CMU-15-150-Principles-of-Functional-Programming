signature SEQUENCE = sig
  (*!
   * The sequence type.
   *)
  type 'a t

  (*!
   * An alias, for readability.
   *)
  type 'a seq = 'a t    (* abstract *)

  (*!
   * `Range` is raised when an index or length is out of range.
   *)
  exception Range of string

  (* Constructing a Sequence *)

  (*!
   * `empty ()` returns `<>`, the empty sequence.
   *)
  val empty : unit -> 'a seq

  (*!
   * `singleton x` returns `<x>`, a sequence of length 1 whose single element is `x`.
   *)
  val singleton : 'a -> 'a seq

  (*!
   * `tabulate f n` returns `<f 0, ..., f (n - 1)>`, the sequence whose elements are generated by
   * applying `f` to the integers from 0 (inclusive) to n (exclusive) in order.
   *)
  val tabulate : (int -> 'a) -> int -> 'a seq

  (*!
   * `fromList [x0, ..., xn-1]` returns `<x0, ..., xn-1>`, the sequence whose elements are the same
   * as the list's.
   *)
  val fromList : 'a list -> 'a seq

  (* Deconstructing a Sequence *)

  (*!
   * `nth <x0, ..., xn-1> i` returns xi, the element at the ith index of the sequence.
   *)
  val nth : 'a seq -> int -> 'a

  (*!
   * `null s` returns where `s` is empty.
   *)
  val null : 'a seq -> bool

  (*!
   * `length <x0, ..., xn-1>` returns n, the length of the sequence.
   *)
  val length : 'a seq -> int

  (*!
   * `toList <x0, ..., xn-1>` returns `[x0, ..., xn-1]`, the list whose elements are the same as the
   * sequence's.
   *)
  val toList : 'a seq -> 'a list

  (*!
   * `toString f s` returns a string representation of s, using `f` to convert the elements of `s`
   * to strings.
   *)
  val toString : ('a -> string) -> 'a seq -> string

  (*!
   * `equal f (s1, s2)` returns whether `s1` is equal to `s2`, using `f` to determine equality
   * between elements of the sequences.
   *)
  val equal : ('a * 'a -> bool) -> 'a seq * 'a seq -> bool

  (* Simple Transformations *)

  (*!
   * `rev <x0, ..., xn-1>` returns `<xn-1, ..., x0>`, the reversal of the input sequence.
   *)
  val rev : 'a seq -> 'a seq

  (*!
   * `append (<x0, ..., xn-1>, <y0, ..., ym-1>)` returns `<x0, ..., xn-1, y0, ..., ym-1>`, the
   * result of appending all of the second sequence's elements onto the first sequence.
   *)
  val append : 'a seq * 'a seq -> 'a seq

  (*!
   * `flatten ss` returns the result of appending all the sequences in `ss` together in order.
   *)
  val flatten : 'a seq seq -> 'a seq

  (*!
   * `cons x <x0, ..., xn-1>` returns `<x, x0, ..., xn-1>`, the result of adding `x` to the front of
   * the sequence.
   *)
  val cons : 'a -> 'a seq -> 'a seq

  (* Combinators and Higher-Order Functions *)

  (*!
   * `filter p s` returns a sequence of all the elements of `s` for which `p` returns true, in
   * order.
   *)
  val filter : ('a -> bool) -> 'a seq -> 'a seq

  (*!
   * `map f <x1, ..., xn>` returns `<f x1, ..., f xn>`, the result of applying `f` to all of the
   * sequence's elements in order.
   *)
  val map : ('a -> 'b) -> 'a seq -> 'b seq

  (*!
   * `reduce f z s` reduces the sequence `s` to a single value, by combining elements of `s`
   * successively down with the associative function `f`.
   *)
  val reduce : ('a * 'a -> 'a) -> 'a -> 'a seq -> 'a

  (*!
   * `reduce1 f s` is like `reduce`, but requires the sequence be non-empty, and
   * does not require a "base" accumulator
   *)
  val reduce1 : ('a * 'a -> 'a) -> 'a seq -> 'a

  (*!
   * `mapreduce f z g s` has the effect of first mapping `f`, then reducing that with `g` and `z`.
   *)
  val mapreduce : ('a -> 'b) -> 'b -> ('b * 'b -> 'b) -> 'a seq -> 'b

  (*!
   * `zip (s1, s2)` returns the sequence of pairs of elements from `s1` and `s2`.
   *)
  val zip : ('a seq * 'b seq) -> ('a * 'b) seq

  (*!
   * `zipWith f (s1, s2)` is like `zip`, except it uses `f` to combine pairs of elements instead of
   * just putting them into pairs as with `zip`.
   *)
  val zipWith : ('a * 'b -> 'c) -> 'a seq * 'b seq -> 'c seq

  (* Indexing-Related Functions *)

  (*!
   * `enum <x0, ..., xn-1>` returns `<(0, x0), ..., (n - 1, xn-1)>`, the sequence of pairs of
   * (element's index, element).
   *)
  val enum : 'a seq -> (int * 'a) seq

  (*!
   * `mapIdx f s` is like `map`, but the mapping function `f` is also passed the index of each
   * element, not just the element. It's like first doing `enum`, then regular `map`.
   *)
  val mapIdx : (int * 'a -> 'b) -> 'a seq -> 'b seq

  (*!
   * `update (s, (i, y))` returns a sequence identical to `s`, except its ith element is y.
   *)
  val update : 'a seq * (int * 'a) -> 'a seq

  (*!
   * `inject (s, ups)` successively `update`s `s` with the updates in `ups` in order.
   *)
  val inject : 'a seq * (int * 'a) seq -> 'a seq

  (*!
   * `subseq s (idx, len)` returns the subsequence of `s` starting at `idx` with length `len`.
   *)
  val subseq : 'a seq -> int * int -> 'a seq

  (*!
   * `take s n` returns the first `n` elements of `s`.
   *)
  val take : 'a seq -> int -> 'a seq

  (*!
   * `drop s n` returns all but the first `n` elements of `s`.
   *)
  val drop : 'a seq -> int -> 'a seq

  (*!
   * `split s n` returns a pair of the first `n` elements of `s` and the rest of the elements.
   *)
  val split : 'a seq -> int -> 'a seq * 'a seq

  (* Sorting and Searching *)

  (*!
   * `sort cmp s` returns `s` sorted by `cmp`. More precisely, it returns a sequence, sorted using
   * the ordering given by `cmp`, whose elements are those of `s`. This is also known as a
   * `cmp`-sorted permutation of `s`.
   *)
  val sort : ('a * 'a -> order) -> 'a seq -> 'a seq

  (*!
   * `merge cmp (s1, s2)` merges the sequences `s1` and `s2`, both of which must already be
   * `cmp`-sorted, into a single sequence.
   *)
  val merge : ('a * 'a -> order) -> 'a seq * 'a seq -> 'a seq

  (*!
   * `search cmp x s` returns the index of `x` in `s`, given that `s` is `cmp`-sorted.
   *)
  val search : ('a * 'a -> order) -> 'a -> 'a seq -> int option

  (* Views *)

  (*!
   * A list-like view into a sequence.
   *)
  datatype 'a lview = Nil | Cons of 'a * 'a seq

  (*!
   * Returns a list view into a sequence.
   *)
  val showl : 'a seq -> 'a lview

  (*!
   * Returns a sequence for the given list view.
   *)
  val hidel : 'a lview -> 'a seq

  (*!
   * A tree-like view into a sequence.
   *)
  datatype 'a tview = Empty | Leaf of 'a | Node of 'a seq * 'a seq

  (*!
   * Returns a tree view into a sequence.
   *)
  val showt : 'a seq -> 'a tview

  (*!
   * Returns a sequence for the given tree view.
   *)
  val hidet : 'a tview -> 'a seq
end
